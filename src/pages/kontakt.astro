---
import Base from '../layouts/Base.astro';
import { getContact } from '../lib/strapi';

const contact = await getContact().catch(() => null);
---

{contact ? (
  <Base title={contact.title}>
    <div class="container-content py-12">
      <h1 class="text-display">{contact.title}</h1>

      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <div>
          <h2 class="text-xl">Kontaktinformasjon</h2>
          <dl class="mt-4 space-y-3">
            {contact.address && (
              <>
                <dt class="text-sm text-ink-muted">Adresse</dt>
                <dd class="whitespace-pre-line">{contact.address}</dd>
              </>
            )}
            {contact.email && (
              <>
                <dt class="text-sm text-ink-muted">E-post</dt>
                <dd>
                  <a href={`mailto:${contact.email}`} class="underline underline-offset-2">
                    {contact.email}
                  </a>
                </dd>
              </>
            )}
            {contact.phone && (
              <>
                <dt class="text-sm text-ink-muted">Telefon</dt>
                <dd>{contact.phone}</dd>
              </>
            )}
            {contact.orgNumber && (
              <>
                <dt class="text-sm text-ink-muted">Org.nr.</dt>
                <dd class="font-mono">{contact.orgNumber}</dd>
              </>
            )}
          </dl>
        </div>

        {contact.mapCoordinates && (
          <div>
            <h2 class="text-xl">Kart</h2>
            <div class="mt-4 aspect-video w-full overflow-hidden rounded-card bg-surface-sunken">
              <iframe
                src={`https://www.google.com/maps?q=${contact.mapCoordinates.latitude},${contact.mapCoordinates.longitude}&z=15&output=embed`}
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        )}
      </div>

      {contact.contactPersons && contact.contactPersons.length > 0 && (
        <div class="mt-12">
          <h2 class="text-xl">Kontaktpersoner</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {contact.contactPersons.map((person) => (
              <li class="rounded-card border border-line bg-surface-raised p-4">
                <p class="font-semibold">{person.name}</p>
                {person.role && <p class="text-sm text-ink-muted">{person.role}</p>}
                {person.email && (
                  <p class="mt-1 text-sm">
                    <a href={`mailto:${person.email}`} class="underline underline-offset-2">
                      {person.email}
                    </a>
                  </p>
                )}
                {person.phone && <p class="text-sm">{person.phone}</p>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </Base>
) : (
  <Base title="Siden ble ikke funnet" maxAge={0}>
    <div class="container-content flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-display text-8xl font-bold text-brand-900">404</p>
      <h1 class="mt-4 text-display">Siden ble ikke funnet</h1>
      <p class="mt-3 max-w-md text-lg text-ink-muted">
        Denne siden er ikke publisert enda.
      </p>
    </div>
  </Base>
)}

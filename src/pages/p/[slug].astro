---
import Base from '../../layouts/Base.astro';
import RichText from '../../components/RichText.astro';
import { getPages } from '../../lib/strapi';

const { slug } = Astro.params;
const page = await getPages({ slug }).catch(() => null);
const children = page ? await getPages({ parent: slug }).catch(() => []) : [];
---

{page ? (
  <Base title={page.title}>
    <div class="container-content py-12">
      <h1 class="text-display">{page.title}</h1>

      {children.length > 0 && (
        <nav class="mt-6 border-b border-line" aria-label="Undersider">
          <ul class="flex gap-4 text-sm">
            {children.map((child) => (
              <li>
                <a
                  href={`/p/${child.slug}`}
                  class="pb-2 hover:underline underline-offset-4"
                >
                  {child.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {page.content && <RichText nodes={page.content} class="mt-8" />}
    </div>
  </Base>
) : (
  <Base title="Siden ble ikke funnet" maxAge={0}>
    <div class="container-content flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-display text-8xl font-bold text-brand-900">404</p>
      <h1 class="mt-4 text-display">Siden ble ikke funnet</h1>
      <p class="mt-3 max-w-md text-lg text-ink-muted">
        Denne siden finnes ikke.
      </p>
    </div>
  </Base>
)}

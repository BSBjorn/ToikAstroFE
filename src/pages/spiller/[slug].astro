---
/**
 * Player profile page — /spiller/[slug].
 * Hero image, about section, stats sidebar, social links.
 */
import Base from "../../layouts/Base.astro";
import RichText from "../../components/RichText.astro";
import { getPlayer, mediaUrl, mediaAlt } from "../../lib/strapi";
import { phosphorPaths } from "../../lib/phosphor-icons";

const { slug } = Astro.params;
const player = await getPlayer(slug).catch(() => null);
---

{player ? (
    <Base title={player.name}>
        <div class="container-content py-16 lg:py-20">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 grid-flow-dense">
                <!-- Hero image -->
                {player.photo && (
                    <img
                        src={mediaUrl(player.photo, "large")}
                        alt={mediaAlt(player.photo)}
                        class="w-full aspect-3/4 object-cover rounded-card"
                    />
                )}
                <!-- Main content -->
                <div class="lg:col-span-2 relative">
                    <h1 class="mt-8 font-black text-hero">{player.name}</h1>
                    {player.number && (
                        <p class="font-dc -z-10 -rotate-6 block text-6xl text-accent-500 absolute right-4 md:right-10 font-medium -top-4 md:top-0 group-hover:animate-vibrate">
                            #{player.number}
                        </p>
                    )}
                    {player.about?.length && (
                        <div class="prose-toik prose-toik-prose mt-8">
                            <RichText nodes={player.about} />
                        </div>
                    )}
                </div>

                <!-- Sidebar — sticky on desktop -->

                <div class="space-y-4">
                    <!-- Stats card -->
                    <h2 class="section-label">Spiller</h2>
                    <div class="rounded-card border border-line bg-surface-raised p-4">
                        <dl class="grid grid-cols-2 gap-3 text-sm">
                            {player.team?.name && (
                                <>
                                    <dt class="text-ink-muted">Lag</dt>
                                    <dd class="font-semibold">
                                        {player.team.name}
                                    </dd>
                                </>
                            )}
                            {player.number && (
                                <>
                                    <dt class="text-ink-muted">Nummer</dt>
                                    <dd class="font-semibold">
                                        #{player.number}
                                    </dd>
                                </>
                            )}
                            {player.position && (
                                <>
                                    <dt class="text-ink-muted">Posisjon</dt>
                                    <dd class="font-semibold">
                                        {player.position}
                                    </dd>
                                </>
                            )}
                            {player.birthYear && (
                                <>
                                    <dt class="text-ink-muted">Født</dt>
                                    <dd class="font-semibold">
                                        {player.birthYear}
                                    </dd>
                                </>
                            )}
                            {player.shoots && (
                                <>
                                    <dt class="text-ink-muted">Skyter</dt>
                                    <dd class="font-semibold">
                                        {player.shoots}
                                    </dd>
                                </>
                            )}
                        </dl>
                    </div>
                </div>
                <!-- Social links -->
                {player.socialLinks && player.socialLinks.length > 0 && (
                    <div class="space-y-4">
                        <h2 class="section-label">Sosialt</h2>
                        <div class="rounded-card border border-line bg-surface-raised p-4">
                            <ul class="space-y-2">
                                {player.socialLinks.map((link) => {
                                    const key =
                                        link.icon ??
                                        link.platform.toLowerCase();
                                    const svgPath = phosphorPaths[key];
                                    if (svgPath) {
                                        return (
                                            <li>
                                                <a
                                                    href={link.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="flex items-center gap-2 text-sm text-ink-muted hover:underline"
                                                >
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="16"
                                                        height="16"
                                                        viewBox="0 0 1024 1024"
                                                        fill="currentColor"
                                                    >
                                                        <path d={svgPath} />
                                                    </svg>
                                                    <span class="truncate">
                                                        {link.label ??
                                                            link.platform}
                                                    </span>
                                                </a>
                                            </li>
                                        );
                                    }
                                    return (
                                        <li>
                                            <a
                                                href={link.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="flex items-center gap-2 text-sm text-ink-muted hover:underline"
                                            >
                                                <i
                                                    class={`ph ph-${key} w-4 h-4`}
                                                />
                                                <span class="truncate">
                                                    {link.label ??
                                                        link.platform}
                                                </span>
                                            </a>
                                        </li>
                                    );
                                })}
                            </ul>
                        </div>
                    </div>
                )}
                <!-- Back to roster -->
                {player.team?.slug && (
                    <a
                        href={`/lag/${player.team.slug}`}
                        class="inline-flex items-end justify-end gap-1 text-sm text-ink-muted transition-colors hover:text-brand-500"
                    >
                        ← Tilbake til troppen
                    </a>
                )}
            </div>
        </div>
    </Base>
) : (
    <Base title="Siden ble ikke funnet" maxAge={0}>
        <div class="container-content flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
            <p class="font-display text-8xl font-bold text-brand-900">404</p>
            <h1 class="mt-4 text-display">Siden ble ikke funnet</h1>
            <p class="mt-3 max-w-md text-lg text-ink-muted">
                Denne spilleren finnes ikke.
            </p>
        </div>
    </Base>
)}

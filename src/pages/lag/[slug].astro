---
import Base from '../../layouts/Base.astro';
import RichText from '../../components/RichText.astro';
import FixtureList from '../../components/FixtureList.astro';
import LiveMatch from '../../components/LiveMatch.vue';
import {
  getTeam,
  getFixtures,
  enrichFixturesWithStats,
  mediaUrl,
  mediaAlt,
  publicStrapiUrl,
} from '../../lib/strapi';

const { slug } = Astro.params;
const team = await getTeam(slug).catch(() => null);
const photo = team ? mediaUrl(team.photo, 'large') : null;

let upcoming: Fixture[] = [];
let recent: Array<Fixture & { stats: any }> = [];
if (slug) {
  [upcoming, recent] = await Promise.all([
    getFixtures(slug, 'upcoming', 4).then(
      (r) => r.data ?? [],
      () => [],
    ),
    enrichFixturesWithStats(
      (await getFixtures(slug, 'completed', 3)).data ?? [],
    ),
  ]);
}
---

{team ? (
  <Base title={team.name}>
    <div class="container-content py-16 lg:py-20">
      {photo && (
        <img
          src={photo}
          alt={mediaAlt(team.photo)}
          width={team.photo?.width ?? undefined}
          height={team.photo?.height ?? undefined}
          class="w-full rounded-card"
        />
      )}
      <h1 class="mt-8 font-bold text-hero">{team.name}</h1>

      {team.description && <div class="prose-toik mt-8">
                <RichText nodes={team.description} />
            </div>}

      {(team?.teamId || upcoming.length > 0 || recent.length > 0) && (
        <section class="mt-12" aria-labelledby="kamper">
          <span class="section-label">KAMPER</span>

          <div class="mt-4 overflow-hidden rounded-card border-l-4 border-accent-500 bg-surface-raised shadow-card">
            {team?.teamId && (
              <LiveMatch
                client:load
                strapiUrl={publicStrapiUrl()}
                team={team.teamId}
              />
            )}

            {(upcoming.length > 0 || recent.length > 0) && (
              <div class="grid gap-8 border-t border-line px-6 py-8 md:grid-cols-2">
                <div>
                  <div class="mb-3 flex items-baseline justify-between">
                    <h3 class="text-xl">Neste kamper</h3>
                    <a
                      href="/kamper"
                      class="text-sm text-ink-muted hover:underline"
                    >
                      Hele terminlisten
                    </a>
                  </div>
                  <FixtureList fixtures={upcoming} type="upcoming" />
                </div>
                <div>
                  <div class="mb-3 flex items-baseline justify-between">
                    <h3 class="text-xl">Siste resultater</h3>
                    <a
                      href="/kamper?type=spilte"
                      class="text-sm text-ink-muted hover:underline"
                    >
                      Alle resultater
                    </a>
                  </div>
                  <FixtureList fixtures={recent} type="completed" />
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      {team.players && team.players.length > 0 && (
        <div class="mt-12">
          <span class="section-label">SPILLERE</span>
          <h2 class="text-xl">Spillere</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {team.players.map((player) => (
              <li class="flex cursor-default items-center gap-3 rounded-card border border-line bg-surface-raised p-3 transition-colors hover:bg-brand-50 dark:hover:bg-brand-900">
                {player.photo && (
                  <img
                    src={mediaUrl(player.photo, 'small') ?? ''}
                    alt={mediaAlt(player.photo)}
                    class="size-12 shrink-0 rounded-full object-cover"
                  />
                )}
                <div>
                  <p class="font-semibold">
                    {player.number && (
                      <span class="text-brand-500">#{player.number}</span>
                    )}
                    <span class="ml-1">{player.name}</span>
                  </p>
                  {player.position && (
                    <p class="text-xs text-ink-muted">{player.position}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </Base>
) : (
  <Base title="Siden ble ikke funnet" maxAge={0}>
    <div class="container-content flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-display text-8xl font-bold text-brand-900">404</p>
      <h1 class="mt-4 text-display">Siden ble ikke funnet</h1>
      <p class="mt-3 max-w-md text-lg text-ink-muted">
        Denne siden finnes ikke.
      </p>
    </div>
  </Base>
)}

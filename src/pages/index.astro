---
/**
 * Front page.
 *
 * Every section fetches independently through Promise.allSettled, so one
 * failing source — Strapi restarting, the federation API timing out — leaves a
 * gap instead of a 500. A club site that half-renders beats one that doesn't.
 *
 * ADJUST: the `frontpage` and `club` single types are read defensively because
 * their field names are yours. Wire the real ones where marked.
 */
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import FixtureList from "../components/FixtureList.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import RichText from "../components/RichText.astro";
import LiveMatch from "../components/LiveMatch.vue";
import {
    getArticles,
    getClub,
    getFixtures,
    getFrontpage,
    getSponsors,
    enrichFixturesWithStats,
    mediaAlt,
    mediaUrl,
    publicStrapiUrl,
} from "../lib/strapi";
import type {
    Article,
    Frontpage,
    Sponsor,
    StrapiMedia,
    Club,
} from "../types/strapi";

/** The team whose fixtures lead the front page. */
const FEATURED_TEAM = import.meta.env.PUBLIC_FEATURED_TEAM_SLUG || "a-lag";

let articles: Article[] = [];
let upcoming: Fixture[] = [];
let recent: Array<Fixture & { stats: any }> = [];
let sponsors: Sponsor[] = [];
let frontpageRaw: { data: Frontpage | null } = { data: null };
let clubRaw: { data: Club | null } = { data: null };

try {
    [articles, upcoming, recent, sponsors, frontpageRaw, clubRaw] =
        await Promise.all([
            getArticles({ pageSize: 5 }).then(
                (r) => r.data ?? [],
                () => [],
            ),
            getFixtures(FEATURED_TEAM, "upcoming", 4).then(
                (r) => r.data ?? [],
                () => [],
            ),
            enrichFixturesWithStats(
                (await getFixtures(FEATURED_TEAM, "completed", 3)).data ?? [],
            ),
            getSponsors().then(
                (r) => r.data ?? [],
                () => [],
            ),
            getFrontpage().catch(() => ({ data: null })),
            getClub().catch(() => ({ data: null })),
        ]);
} catch {
    /* should not happen — every item has fallbacks */
}

const frontpage: Frontpage = frontpageRaw?.data ?? {};
const club: Club = clubRaw?.data ?? {};

const heroTitle: string = frontpage.hero?.title ?? frontpage.title ?? "TITLE";
const heroText: string = frontpage.hero?.subtitle ?? "SUBTITLE";
const heroImage: StrapiMedia | null = frontpage.hero?.image ?? null;
const teamTitlePart1: string = frontpage.hero?.teamTitlePart1 ?? "Tønsberg ";
const teamTitlePart2: string = frontpage.hero?.teamTitlePart2 ?? "Vikings";
const fullClubName: string =
    frontpage.hero?.fullClubName ?? "Tønsberg og Omegn ishockeyklubb";
const fixturesTeamLabel: string =
    frontpage.hero?.fixturesTeamLabel ?? "tønsberg viking";
const orgNumber: string | null = club.grasrotandelenOrgNumber ?? null;
const pinnedArticle: Article | null = frontpage.pinnedArticle ?? null;
const [lead, ...rest] = articles;
const heroSrc = mediaUrl(heroImage) ?? null;

// Build section map from frontpage sections config
const sectionMap: Record<string, boolean> = {};
const sectionData: Record<
    string,
    { title: string; content: unknown[]; image: StrapiMedia | null }
> = {};
for (const s of frontpage.sections ?? []) {
    sectionMap[s.sectionId] = s.enabled ?? true;
    sectionData[s.sectionId] = {
        title: s.title,
        content: s.content ?? [],
        image: (s as any).image ?? null,
    };
}
// Default: show news/sponsors if no sections defined
sectionMap.news = sectionMap.news ?? true;
sectionMap.sponsors = sectionMap.sponsors ?? true;
---

<Base
    title={club.name}
    description={heroText}
    image={heroSrc}
    maxAge={300}
    clubName={club.name}
    clubSlogan={club.slogan ?? undefined}
>
    <!-- Hero — dark image + team title overlay -->
    {frontpage.hero ? (
        <section class="relative isolate overflow-hidden bg-brand-900 text-ink-invert min-h-[50vh] lg:min-h-[70vh]">
            {/* Image fade from bottom */}
            <div class="absolute inset-0 after:pointer-events-none after:absolute after:bottom-0 after:left-0 after:right-0 after:h-2/3 after:bg-gradient-to-t after:from-brand-700/40 -z-10" />
            {heroSrc && (
                <img
                    src={heroSrc}
                    alt={mediaAlt(heroImage)}
                    class="absolute inset-0 -z-20 size-full object-cover opacity-85 background-position-bottom"
                    fetchpriority="high"
                    decoding="async"
                />
            )}
            <div class="teamTitleHero absolute bottom-0 right-0 xl:bottom-1/6 3xl:right-20 p-10 text-right uppercase">
                <p class="teamTitle">
                    <span class="teamTitlePart1">{teamTitlePart1}</span>
                    <span class="teamTitlePart2">{teamTitlePart2}</span>
                </p>
            </div>
        </section>
    ) : (
        <section class="relative isolate overflow-hidden bg-brand-900 text-ink-invert">
            <div class="container-content py-16 sm:py-24">
                <h1 class="max-w-3xl text-hero text-white/75">
                    Velkommen til TOIK
                </h1>
                <p class="mt-3 max-w-md text-lg text-ice-300">
                    Rediger hero-innhold i Strapi admin for å vise eget bilde og
                    tekst.
                </p>
            </div>
        </section>
    )}

    <!-- Hero content — club name, title, description + CTAs -->
    {frontpage.hero ? (
        <section class="container-content py-10 sm:py-16 md:py-24 text-ink md:pl-20">
            <h1 class="font-display text-h1 mt-5 sm:mt-10 md:mt-16 font-bold">
                {fullClubName}
            </h1>
            <h2 class="font-display text-h2 mt-1.5 font-medium">
                {heroTitle}
            </h2>
            <p class="mt-2 max-w-2xl text-sm sm:mt-4 md:text-xl">{heroText}</p>
            <div class="mt-5 flex flex-wrap gap-3 sm:my-8">
                <a
                    href={frontpage.hero?.ctaLink || "/kamper"}
                    class="rounded-pill border bg-ice-200/80 border-ice-100/80 px-8 py-3.5 font-semibold text-ice-800 transition hover:bg-white/10 hover:text-ice-100"
                >
                    {frontpage.hero?.ctaText || "Se kampoppsettet"}
                </a>
                <a
                    href="/p/ny-i-klubben"
                    class="rounded-pill border border-accent-500 bg-accent-500 px-8 py-3.5 font-semibold text-white transition hover:bg-accent-500/10"
                >
                    Bli med i klubben
                </a>
            </div>
        </section>
    ) : (
        <section class="container-content py-10 sm:py-16 md:py-24 text-ink md:pl-20">
            <h1 class="font-display text-h1 mt-5 sm:mt-10 md:mt-16 font-bold">
                {fullClubName}
            </h1>
            <h2 class="font-display text-h2 mt-1.5 font-medium">{heroTitle}</h2>
            <p class="mt-2 max-w-2xl text-sm sm:mt-4 md:text-xl">{heroText}</p>
        </section>
    )}
    <!-- Live match + fixtures — prominent red-accent card -->
    {(upcoming.length > 0 || recent.length > 0) && (
        <section class="container-content mt-12 mb-16" aria-labelledby="kamper">
            <span class="section-label">{fixturesTeamLabel}</span>

            <div class="mt-4 overflow-hidden rounded-card bg-surface-raised shadow-card">
                <LiveMatch
                    client:load
                    strapiUrl={publicStrapiUrl()}
                    team={FEATURED_TEAM}
                />

                <div class="grid gap-8 px-6 py-8 md:grid-cols-2">
                    <div>
                        <div class="mb-3 flex items-baseline justify-between">
                            <h3 class="font-display text-h3">Neste kamper</h3>
                            <a
                                href="/kamper"
                                class="text-sm text-ink-muted hover:underline"
                            >
                                Hele terminlisten
                            </a>
                        </div>
                        <FixtureList fixtures={upcoming} type="upcoming" />
                    </div>
                    <div>
                        <div class="mb-3 flex items-baseline justify-between">
                            <h3 class="font-display text-h3">
                                Siste resultater
                            </h3>
                            <a
                                href="/kamper?type=spilte"
                                class="text-sm text-ink-muted hover:underline"
                            >
                                Alle resultater
                            </a>
                        </div>
                        <FixtureList fixtures={recent} type="completed" />
                    </div>
                </div>
            </div>
        </section>
    )}
    <!-- News -->
    {sectionMap.news && articles.length > 0 && (
        <section class="container-content mb-16" aria-labelledby="nyheter">
            <div class="mb-6 flex items-baseline justify-between">
                <span class="section-label">NYHETER</span>
                <a
                    href="/nyheter"
                    class="text-sm text-ink-muted hover:underline"
                >
                    Alle nyheter
                </a>
            </div>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {pinnedArticle && (
                    <ArticleCard article={pinnedArticle} featured />
                )}
                {lead && !pinnedArticle && (
                    <ArticleCard article={lead} featured />
                )}
                {rest.map((article) => (
                    <ArticleCard article={article} />
                ))}
            </div>
        </section>
    )}
    <!-- Dynamic sections from frontpage config -->
    {Object.entries(sectionData).map(([id, section], idx) => {
        if (!sectionMap[id]) return null;
        const sectionImg = section.image
            ? mediaUrl(section.image as any, "medium")
            : null;
        const imageFirst = idx % 2 === 0;
        return (
            <section
                class="container-content mb-16"
                aria-labelledby={`section-${id}`}
            >
                {sectionImg && (
                    <div class="flex gap-8 flex-wrap md:flex-nowrap">
                        <div
                            class:list={[
                                "overflow-hidden rounded-card w-full md:w-1/3",
                                imageFirst ? "md:order-1" : "md:order-2",
                            ]}
                        >
                            <img
                                src={sectionImg}
                                alt={section.title}
                                class="size-full object-cover"
                                loading="lazy"
                            />
                        </div>
                        <div class="md:w-2/3 order-1">
                            <h2
                                id={`section-${id}`}
                                class="text-display font-black"
                            >
                                {section.title}
                            </h2>
                            <div class="prose prose-lg mt-6 text-ink">
                                <RichText nodes={section.content as any} />
                            </div>
                        </div>
                    </div>
                )}
                {!sectionImg && (
                    <div>
                        <h2
                            id={`section-${id}`}
                            class="text-display font-black text-center"
                        >
                            {section.title}
                        </h2>
                        <div class="prose prose-lg mt-6 text-ink">
                            <RichText nodes={section.content as any} />
                        </div>
                    </div>
                )}
            </section>
        );
    })}
    {sectionMap.sponsors && (
        <SponsorGrid sponsors={sponsors} label="SAMARBEIDSPARTNERE" />
    )}
</Base>

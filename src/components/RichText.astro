---
/**
 * Renders Strapi's `blocks` rich-text field.
 *
 * Recursive: inline marks nest, so component imports itself children.
 * Anything unrecognised renders its children vanishing — new
 * Strapi block type should degrade text, not disappear page.
 *
 * No wrapper div — consumers add `.prose-toik` (or nothing) as needed.
 */
import type { BlockNode } from '../types/strapi';
import { mediaUrl, mediaAlt } from '../lib/strapi';
import Self from './RichText.astro';

interface Props {
  nodes: BlockNode[] | null | undefined;
  class?: string;
}

const { nodes, class: className = '' } = Astro.props;

/** Leaf text nodes carry marks booleans. */
function isText(node: BlockNode): boolean {
  return typeof node.text === 'string';
}
---

{nodes?.length ? (
  <>
    {nodes.map((node) => {
      if (isText(node)) {
        let el: any = node.text;
        if (node.bold) el = <strong>{el}</strong>;
        if (node.italic) el = <em>{el}</em>;
        if (node.underline) el = <u>{el}</u>;
        if (node.strikethrough) el = <s>{el}</s>;
        if (node.code) el = <code class="rounded bg-surface-sunken px-1 py-0.5 text-[0.9em]">{el}</code>;
        return el;
      }

      switch (node.type) {
        case 'paragraph':
          return <p><Self nodes={node.children} /></p>;

        case 'heading': {
          const Tag = `h${Math.min(Math.max(node.level as number, 1), 6)}` as keyof JSX.IntrinsicElements;
          return (
            <Tag>
              <Self nodes={node.children} />
            </Tag>
          );
        }

        case 'list': {
          const isOrdered = (node.bulletListMarker ?? 'disc') === 'order';
          const ListTag = isOrdered ? 'ol' : 'ul';
          return (
            <ListTag class="list-disc pl-6">
              <Self nodes={node.children} />
            </ListTag>
          );
        }

        case 'listItem':
          return <li><Self nodes={node.children} /></li>;

        case 'divider':
          return <hr class="my-6" />;

        case 'media': {
          const src = mediaUrl(node.media);
          return (
            <figure class="my-6">
              <img
                src={src}
                alt={mediaAlt(node.image)}
                width={node.image?.width ?? undefined}
                height={node.image?.height ?? undefined}
                loading="lazy"
                decoding="async"
                class="w-full"
              />
              {node.image?.caption &&
                <figcaption class="mt-2 text-sm text-ink-muted">{node.image.caption}</figcaption>
              }
            </figure>
          );
        }

        default:
          // Unknown block: keep words on page
          return <Self nodes={node.children} />;

      }
    })}
  </>
) : null}

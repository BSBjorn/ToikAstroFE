---
/**
 * Renders Strapi's `blocks` rich-text field.
 *
 * Recursive: inline marks nest, so the component imports itself for children.
 * Anything unrecognised renders its children rather than vanishing — a new
 * Strapi block type should degrade to its text, not disappear from the page.
 */
import type { BlockNode } from '../types/strapi';
import { mediaUrl, mediaAlt } from '../lib/strapi';
import Self from './RichText.astro';

interface Props {
  nodes: BlockNode[] | null | undefined;
  class?: string;
}

const { nodes, class: className = '' } = Astro.props;

/** Leaf text nodes carry their marks as booleans. */
function isText(node: BlockNode): boolean {
  return typeof node.text === 'string';
}
---

{
  nodes?.length ? (
    <div class={`prose-toik ${className}`}>
      {nodes.map((node) => {
        if (isText(node)) {
          let el: any = node.text;
          if (node.bold) el = <strong>{el}</strong>;
          if (node.italic) el = <em>{el}</em>;
          if (node.underline) el = <u>{el}</u>;
          if (node.strikethrough) el = <s>{el}</s>;
          if (node.code) el = <code class="rounded bg-surface-sunken px-1 py-0.5 text-[0.9em]">{el}</code>;
          return el;
        }

        switch (node.type) {
          case 'paragraph':
            return <p><Self nodes={node.children} /></p>;

          case 'heading': {
            const Tag = `h${Math.min(Math.max(node.level ?? 2, 2), 4)}` as 'h2' | 'h3' | 'h4';
            return <Tag><Self nodes={node.children} /></Tag>;
          }

          case 'list': {
            const Tag = node.format === 'ordered' ? 'ol' : 'ul';
            return (
              <Tag class={node.format === 'ordered' ? 'list-decimal pl-6' : 'list-disc pl-6'}>
                <Self nodes={node.children} />
              </Tag>
            );
          }

          case 'list-item':
            return <li><Self nodes={node.children} /></li>;

          case 'quote':
            return (
              <blockquote class="border-l-4 border-accent-500 pl-4 italic text-ink-muted">
                <Self nodes={node.children} />
              </blockquote>
            );

          case 'code':
            return (
              <pre class="overflow-x-auto rounded-card bg-surface-sunken p-4 text-sm"><code><Self nodes={node.children} /></code></pre>
            );

          case 'link':
            return (
              <a href={node.url} rel={node.url?.startsWith('http') ? 'noopener' : undefined}>
                <Self nodes={node.children} />
              </a>
            );

          case 'image': {
            const src = mediaUrl(node.image, 'large');
            return src ? (
              <figure class="my-6">
                <img
                  src={src}
                  alt={mediaAlt(node.image)}
                  width={node.image?.width ?? undefined}
                  height={node.image?.height ?? undefined}
                  loading="lazy"
                  decoding="async"
                  class="w-full rounded-card"
                />
                {node.image?.caption && (
                  <figcaption class="mt-2 text-sm text-ink-muted">{node.image.caption}</figcaption>
                )}
              </figure>
            ) : null;
          }

          default:
            // Unknown block: keep the words on the page
            return <Self nodes={node.children} />;
        }
      })}
    </div>
  ) : null
}

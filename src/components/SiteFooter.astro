---
interface Props {
  orgNumber?: string | null;
  email?: string | null;
  address?: string | null;
}

const { orgNumber, email, address } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line bg-surface-sunken py-12">
  <div class="container-content">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-lg">Tønsberg og Omegn Ishockeyklubb</p>
        <p class="mt-2 text-sm text-ink-muted">Én klubb, mange lag.</p>
        {address && <p class="mt-4 whitespace-pre-line text-sm text-ink-muted">{address}</p>}
        {
          email && (
            <p class="mt-2 text-sm">
              <a href={`mailto:${email}`} class="underline underline-offset-2">{email}</a>
            </p>
          )
        }
      </div>

      <nav aria-label="Hovedlenker" class="grid flex-grow gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <ul class="space-y-2 text-sm">
          <li><a href="/lag" class="hover:underline underline-offset-2">Lag og treningsgrupper</a></li>
          <li><a href="/kamper" class="hover:underline underline-offset-2">Kamper</a></li>
          <li><a href="/nyheter" class="hover:underline underline-offset-2">Nyheter</a></li>
        </ul>
        <ul class="space-y-2 text-sm">
          <li><a href="/sponsorer" class="hover:underline underline-offset-2">Samarbeidspartnere</a></li>
          <li><a href="/kontakt" class="hover:underline underline-offset-2">Kontakt</a></li>
          <li><a href="/varsle" class="hover:underline underline-offset-2">Varsle om kritikkverdige forhold</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-line pt-6 text-xs text-ink-muted sm:flex-row sm:justify-between">
      <p>&copy; {year} Tønsberg og Omegn Ishockeyklubb</p>
      {orgNumber && <p>Org.nr. {orgNumber}</p>}
    </div>
  </div>
</footer>

---
import { phosphorPaths } from "../lib/phosphor-icons";
import { mediaUrl } from "../lib/strapi";

interface Props {
    orgNumber?: string | null;
    clubName?: string;
    clubSlogan?: string | null;
    footerLogo?: import("../types/strapi").StrapiMedia | null;
    footerLinkGroups?: import("../types/strapi").FooterLinkGroup[] | null;
    socialLinks?: Array<{
        platform: string;
        url: string;
        icon?: string | null;
    }> | null;
}

const {
    orgNumber,
    clubName = "Tønsberg og Omegn Ishockeyklubb",
    clubSlogan,
    footerLogo,
    footerLinkGroups,
    socialLinks = [],
} = Astro.props;
const year = new Date().getFullYear();

const footerLogoSrc = footerLogo ? mediaUrl(footerLogo, "thumbnail") : null;
---

<footer id="footer" class="border-t border-line bg-surface-sunken">
    <div class="container-content">
        <div class="grid gap-10 pt-14 lg:gap-14 lg:grid-cols-[1.5fr_2fr] xl:grid-cols-[1.5fr_2fr_auto]">

            <!-- Brand column -->
            <div class="flex items-center gap-4 sm:items-start">
                {footerLogoSrc && (
                    <img
                        src={footerLogoSrc}
                        alt={`${clubName} logo`}
                        width={footerLogo?.width ?? 120}
                        height={footerLogo?.height ?? 80}
                        loading="lazy"
                        class="h-12 w-auto shrink-0 object-contain"
                    />
                )}
                <div>
                    <p class="font-display text-lg">{clubName}</p>
                    {clubSlogan && (
                        <p class="mt-3 text-xs font-semibold uppercase tracking-widest text-accent-500/80">
                            {clubSlogan}
                        </p>
                    )}
                </div>
            </div>

            <!-- Links column -->
            {footerLinkGroups?.length ? (
                <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2 md:gap-x-14 lg:grid-cols-[repeat(auto-fit,minmax(7rem,1fr))] xl:grid-cols-3">
                    {footerLinkGroups.map((group) => (
                        <li>
                            <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-ink-muted/80">
                                {group.title}
                            </h3>
                            <ul class="space-y-2">
                                {group.links.map((link) => {
                                    // Prefer page relation (auto URL), fall back to manual url, skip if neither
                                    const href = link.page
                                        ? `/p/${link.page.slug}`
                                        : link.url;
                                    if (!href || !link.label) return null;
                                    return (
                                        <li>
                                            <a href={href} class="link-footer">
                                                {link.label}
                                            </a>
                                        </li>
                                    );
                                })}
                            </ul>
                        </li>
                    ))}
                </ul>
            ) : null}

            <!-- Social column -->
            {socialLinks.length > 0 && (
                <div class="self-start">
                    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-ink-muted/80">
                        Følg oss
                    </p>
                    <div class="flex gap-3">
                        {socialLinks.map((link) => {
                            const iconKey = link.icon ?? link.platform.toLowerCase();
                            const svgPath = phosphorPaths[iconKey];
                            if (svgPath) {
                                return (
                                    <a
                                        href={link.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={link.platform}
                                        class="flex size-9 items-center justify-center rounded-full bg-surface-raised text-ink-muted shadow-sm transition hover:bg-brand-600 hover:text-white dark:bg-surface dark:hover:bg-brand-600 dark:hover:text-white"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            viewBox="0 0 1024 1024"
                                            fill="currentColor"
                                        >
                                            <path d={svgPath} />
                                        </svg>
                                    </a>
                                );
                            }
                            return (
                                <a
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={link.platform}
                                    class="flex size-9 items-center justify-center rounded-full bg-surface-raised text-ink-muted shadow-sm transition hover:bg-brand-600 hover:text-white dark:bg-surface dark:hover:bg-brand-600 dark:hover:text-white"
                                >
                                    <i class={`ph ph-${iconKey} w-4 h-4`} />
                                </a>
                            );
                        })}
                    </div>
                </div>
            )}
        </div>

        <div class="mt-10 flex flex-col gap-2 border-t border-line py-5 text-xs text-ink-muted sm:flex-row sm:justify-between">
            <p>
                &copy; {year} {clubName}. Alle rettigheter reservert.
            </p>
            {orgNumber && <p>Org.nr. {orgNumber}</p>}
        </div>
    </div>
</footer>

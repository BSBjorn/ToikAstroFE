---
/**
 * Site header. Navigation driven by Pages (Strapi) plus dynamic "Nyheter" and
 * "Lag" items that appear only when entries exist in those collections.
 */
import type { Page, StrapiMedia } from "../types/strapi";
import { getArticles, getPages, getTeams, mediaUrl } from "../lib/strapi";

interface Props {
    logo: StrapiMedia | null;
    clubName?: string;
    clubSlogan?: string | null;
}

const {
    logo,
    clubName = "Team Name",
    clubSlogan = "team slogan",
} = Astro.props;

const menuPages: Page[] = (await getPages({ menuOnly: true })) ?? [];
const teamsRes = await getTeams().catch(() => null);
const articlesRes = await getArticles({ pageSize: 1 }).catch(() => null);
const showLag = (teamsRes?.data?.length ?? 0) > 0;
const showNyheter = (articlesRes?.data?.length ?? 0) > 0;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

type MenuItem = { label: string; href: string };
const menuItems: MenuItem[] = [
    ...(showNyheter ? [{ label: "Nyheter", href: "/nyheter" }] : []),
    ...(showLag ? [{ label: "Lag", href: "/lag" }] : []),
    ...menuPages.map((page) => ({
        label: page.title,
        href: `/${page.parent?.slug ? `${page.parent.slug}/${page.slug}` : page.slug}`,
    })),
];

const logoSrc = logo ? mediaUrl(logo, "thumbnail") : null;
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur">
    <div class="container-content flex h-16 items-center justify-between gap-6">

        <a
            href="/"
            class="flex items-center gap-3 font-display text-lg leading-none"
        >
            {logoSrc ? (
                <img src={logoSrc} alt={`${clubName} logo`} />
            ) : (
                <span class="grid size-9 shrink-0 place-items-center rounded-pill bg-brand-900 text-sm font-bold text-white">
                    {clubName}
                </span>
            )}
        </a>

        <!-- Desktop nav -->
        <nav aria-label="Hovedmeny" class="hidden md:block">
            <ul class="flex items-center gap-1">
                {menuItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            aria-current={isActive(item.href) ? "page" : undefined}
                            class:list={[
                                "rounded-pill px-3 py-2 text-sm font-semibold uppercase tracking-wide transition",
                                isActive(item.href)
                                    ? "bg-surface-sunken text-ink"
                                    : "text-ink-muted hover:bg-surface-sunken hover:text-ink",
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <!-- No-JS mobile menu -->
        <details class="md:hidden [&[open]_svg.close]:block [&[open]_svg.open]:hidden">
            <summary class="grid size-10 cursor-pointer items-center justify-center rounded-pill text-ink-muted">
                <svg
                    class="open size-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
                </svg>
                <svg
                    class="close hidden size-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
                </svg>
            </summary>
            <nav
                aria-label="Mobilmeny"
                class="absolute inset-x-0 top-16 border-b border-line bg-surface-raised shadow-card"
            >
                <ul class="container-content flex flex-col py-2">
                    {menuItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                aria-current={isActive(item.href) ? "page" : undefined}
                                class="block border-b border-line py-3 font-semibold uppercase tracking-wide last:border-0"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </details>
    </div>
</header>

---
/**
 * Site header. Navigation driven by Pages (Strapi) plus dynamic "Nyheter"
 * "Lag" items appear only entries exist in collections.
 */
import type { StrapiMedia } from "../types/strapi";
import { getPageTree, getArticles, getTeams, mediaUrl } from "../lib/strapi";

interface Props {
    logo: StrapiMedia | null;
    clubName?: string;
    clubSlogan?: string | null;
}

const {
    logo,
    clubName = "Team Name",
    clubSlogan = "team slogan",
} = Astro.props;

// Fetch pages proper parent→children hierarchy custom endpoint
const tree = await getPageTree().catch(() => []);
const teamsRes = await getTeams().catch(() => null);
const articlesRes = await getArticles({ pageSize: 1 }).catch(() => null);
const showLag = (teamsRes?.data?.length ?? 0) > 0;
const showNyheter = (articlesRes?.data?.length ?? 0) > 0;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

// --- Build menu items tree hierarchy ---

interface NavItem {
    label: string;
    href: string;
}

type Group =
    | { kind: "flat"; item: NavItem }
    | { kind: "dropdown"; parent: NavItem; children: NavItem[] };

let groups: Group[] = [];
const seenSlugs = new Set<string>();

// Flat items first
if (showNyheter)
    groups.push({ kind: "flat", item: { label: "Nyheter", href: "/nyheter" } });
if (showLag)
    groups.push({ kind: "flat", item: { label: "Lag", href: "/lag" } });

// Pages from Strapi
const buildGroups = (items: TreeNode[]) => {
    items.forEach((navItem) => {
        // Skip pages that should not appear in navigation
        if (navItem.showInMenu === false) return;

        // Deduplicate: a page might appear as top-level and as child of another parent
        if (seenSlugs.has(navItem.slug)) return;
        seenSlugs.add(navItem.slug);

        const hasChildren = navItem.children && navItem.children.length > 0;
        if (hasChildren) {
            groups.push({
                kind: "dropdown",
                parent: { label: navItem.title, href: `/p/${navItem.slug}` },
                children: navItem.children.filter((child) => {
                    if (child.showInMenu === false) return false;
                    if (seenSlugs.has(child.slug)) return false;
                    seenSlugs.add(child.slug);
                    return true;
                }).map((child) => ({
                    label: child.title,
                    href: `/p/${child.slug}`,
                })),
            });
        } else {
            groups.push({ kind: "flat", item: { label: navItem.title, href: `/p/${navItem.slug}` } });
        }
    });
};

buildGroups(tree);

const logoSrc = logo ? mediaUrl(logo, "thumbnail") : null;
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur">
    <div class="container-content flex h-16 items-center justify-between gap-6">

        <!-- Logo -->
        <a
            href="/"
            class="flex items-center gap-3 font-display text-lg leading-none"
        >
            {logoSrc ? (
                <img src={logoSrc} alt={`${clubName} logo`} />
            ) : (
                <span class="grid size-9 shrink-0 place-items-center rounded-pill bg-brand-900 text-sm font-bold text-white">
                    {clubName}
                </span>
            )}
        </a>

        <!-- Desktop nav -->
        <nav aria-label="Hovedmeny" class="hidden md:block">
            <ul class="flex items-center gap-x-6">
                {groups.map((group) => (
                    <li class="relative">
                        {group.kind === "dropdown" ? (
                            <>
                                <a
                                    href={group.parent.href}
                                    aria-current={isActive(group.parent.href) ? "page" : undefined}
                                    class:list={[
                                        "nav-link gap-1 items-center",
                                        isActive(group.parent.href)
                                            ? "nav-link-active"
                                            : "",
                                    ]}
                                >
                                    <span>{group.parent.label}</span>
                                    <!-- Chevron toggle — stopPropagation so nav link click fires -->
                                    <button
                                        type="button"
                                        aria-expanded="false"
                                        aria-controls={`dropdown-${group.parent.href.replace(/\//g, '-')}`}
                                        class="nav-chevron -mr-1 p-0.5 text-ink-muted transition hover:text-ink"
                                    >
                                        <svg
                                            class="size-3.5 transition-transform duration-200"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            <path d="M6 9l6 6 6-6" />
                                        </svg>
                                    </button>
                                </a>
                                <!-- Dropdown panel -->
                                <ul
                                    id={`dropdown-${group.parent.href.replace(/\//g, '-')}`}
                                    role="menu"
                                    class="absolute left-1/2 top-full -translate-x-1/2 mt-2 w-48 rounded-lg border border-line bg-surface-raised shadow-card p-1 opacity-0 invisible transition-all duration-200 pointer-events-none"
                                >
                                    {group.children.map((child) => (
                                        <li role="none">
                                            <a
                                                href={child.href}
                                                role="menuitem"
                                                aria-current={isActive(child.href) ? "page" : undefined}
                                                class:list={[
                                                    "block rounded-md px-3 py-2 text-sm font-medium transition",
                                                    isActive(child.href)
                                                        ? "bg-surface-sunken text-ink"
                                                        : "text-ink-muted hover:bg-surface-sunken hover:text-ink",
                                                ]}
                                            >
                                                {child.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </>
                        ) : (
                            <a
                                href={group.item.href}
                                aria-current={isActive(group.item.href) ? "page" : undefined}
                                class:list={[
                                    "nav-link",
                                    isActive(group.item.href)
                                        ? "nav-link-active"
                                        : "",
                                ]}
                            >
                                {group.item.label}
                            </a>
                        )}
                    </li>
                ))}
            </ul>
        </nav>

        <!-- Dark mode toggle -->
        <button
            type="button"
            id="theme-toggle"
            aria-label="Bytt mellom lys og mørk modus"
            class="grid size-10 shrink-0 place-items-center rounded-pill text-ink-muted transition hover:bg-surface-sunken hover:text-ink"
        >
            <svg id="theme-icon-sun" class="size-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" stroke-linecap="round" />
            </svg>
            <svg id="theme-icon-moon" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <!-- Mobile menu button -->
        <button
            type="button"
            id="mobile-menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Åpne meny"
            class="grid size-10 shrink-0 place-items-center rounded-pill text-ink-muted transition hover:bg-surface-sunken hover:text-ink md:hidden"
        >
            <svg
                id="mobile-menu-icon-open"
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
            </svg>
            <svg
                id="mobile-menu-icon-close"
                class="size-5 hidden"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <!-- Mobile menu panel -->
    <div
        id="mobile-menu"
        class="fixed inset-x-0 top-16 z-50 hidden border-b border-line bg-surface-raised shadow-card md:hidden"
    >
        <nav aria-label="Mobilmeny" class="container-content flex flex-col py-2">
            <ul>
                {groups.map((group) => (
                    <li>
                        {group.kind === "flat" ? (
                            <a
                                href={group.item.href}
                                aria-current={isActive(group.item.href) ? "page" : undefined}
                                class:list={[
                                    "block border-b border-line py-3 px-3 font-semibold uppercase tracking-wide last:border-0",
                                    isActive(group.item.href)
                                        ? "nav-link-active"
                                        : "hover:bg-surface-sunken",
                                ]}
                            >
                                {group.item.label}
                            </a>
                        ) : (
                            <>
                                <!-- Mobile dropdown parent — label links, chevron toggles -->
                                <a
                                    href={group.parent.href}
                                    aria-current={isActive(group.parent.href) ? "page" : undefined}
                                    class:list={[
                                        "block border-b border-line py-3 px-3 text-left text-sm font-bold uppercase tracking-wide last:border-0",
                                        isActive(group.parent.href)
                                            ? "nav-link-active"
                                            : "hover:bg-surface-sunken",
                                    ]}
                                >
                                    <span class="flex items-center justify-between">
                                        <span>{group.parent.label}</span>
                                        <!-- Chevron toggle — stopPropagation so nav link click fires -->
                                        <button
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls={`mobile-dropdown-${group.parent.href.replace(/\//g, '-')}`}
                                            class="mobile-dropdown-chevron-toggle -mr-1 p-0.5 text-ink-muted transition hover:text-ink"
                                        >
                                            <svg
                                                class="size-4 transition-transform duration-200"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                aria-hidden="true"
                                            >
                                                <path d="M6 9l6 6 6-6" />
                                            </svg>
                                        </button>
                                    </span>
                                </a>
                                <!-- Mobile dropdown children -->
                                <ul
                                    id={`mobile-dropdown-${group.parent.href.replace(/\//g, '-')}`}
                                    class="mobile-dropdown-panel hidden bg-surface-sunken/50"
                                >
                                    {group.children.map((child) => (
                                        <a
                                            href={child.href}
                                            aria-current={isActive(child.href) ? "page" : undefined}
                                            class="block border-b border-line py-2.5 pl-6 pr-3 text-sm font-medium last:border-0 hover:bg-surface-sunken"
                                        >
                                            {child.label}
                                        </a>
                                    ))}
                                </ul>
                            </>
                        )}
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<script>
    // Desktop dropdown toggles — only the chevron toggles, the parent <a> navigates
    const desktopDropdowns = document.querySelectorAll('[aria-controls^="dropdown-"]');
    const dropdownStates = new Map<Element, { open: boolean }>();

    function setOpenState(chevron: Element, panel: Element, state: boolean) {
        chevron.setAttribute('aria-expanded', String(state));
        (chevron.querySelector('svg') as SVGElement)?.style.setProperty('transform', state ? 'rotate(180deg)' : '');
        panel.classList.toggle('opacity-0', !state);
        panel.classList.toggle('invisible', !state);
        panel.classList.toggle('pointer-events-none', !state);
        panel.classList.toggle('opacity-100', state);
        panel.classList.toggle('visible', state);
        panel.classList.toggle('transition-opacity', state);
    }

    desktopDropdowns.forEach((chevron) => {
        const panelId = chevron.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!panel) return;
        dropdownStates.set(chevron, { open: false });

        chevron.addEventListener('click', (e) => {
            e.stopPropagation();  // prevent parent <a> from navigating
            const state = dropdownStates.get(chevron)!;
            setOpenState(chevron, panel, !state.open);
            state.open = !state.open;
        });
    });

    // Close any dropdown on outside click
    document.addEventListener('click', (e) => {
        dropdownStates.forEach((state, chevron) => {
            const panelId = chevron.getAttribute('aria-controls');
            const panel = panelId ? document.getElementById(panelId) : null;
            if (state.open && panel && !chevron.contains(e.target as Node) && !panel.contains(e.target as Node)) {
                setOpenState(chevron, panel, false);
                state.open = false;
            }
        });
    });

    // Close any dropdown on Escape
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        dropdownStates.forEach((state, chevron) => {
            if (!state.open) return;
            const panelId = chevron.getAttribute('aria-controls');
            const panel = panelId ? document.getElementById(panelId) : null;
            setOpenState(chevron, panel ?? chevron, false);
            state.open = false;
        });
    });

    // Mobile dropdown toggles — only the chevron toggles, the parent <a> navigates
    const mobileDropdownChevrons = document.querySelectorAll('.mobile-dropdown-chevron-toggle');
    const mobileDropdownStates = new Map<Element, { open: boolean }>();

    mobileDropdownChevrons.forEach((chevron) => {
        const panelId = chevron.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!panel) return;
        mobileDropdownStates.set(chevron, { open: false });

        chevron.addEventListener('click', (e) => {
            e.stopPropagation();  // prevent parent <a> from navigating
            const state = mobileDropdownStates.get(chevron)!;
            state.open = !state.open;
            chevron.setAttribute('aria-expanded', String(state.open));
            panel.classList.toggle('hidden', !state.open);
            (chevron.querySelector('svg') as SVGElement)?.style.setProperty('transform', state.open ? 'rotate(180deg)' : '');
        });
    });

    // Mobile menu toggle
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');

    if (mobileToggle && mobileMenu) {
        let menuOpen = false;

        mobileToggle.addEventListener('click', () => {
            menuOpen = !menuOpen;
            mobileToggle.setAttribute('aria-expanded', String(menuOpen));
            mobileMenu.classList.toggle('hidden', !menuOpen);
            mobileToggle.setAttribute('aria-label', menuOpen ? 'Lukk meny' : 'Åpne meny');

            if (iconOpen && iconClose) {
                iconOpen.classList.toggle('hidden', menuOpen);
                iconClose.classList.toggle('hidden', !menuOpen);
            }
        });

        // Close mobile menu on link click — single delegated listener
        mobileMenu.addEventListener('click', (e) => {
            const link = (e.target as Element).closest('a');
            if (!link) return;
            e.stopPropagation();
            menuOpen = false;
            mobileToggle.setAttribute('aria-expanded', 'false');
            mobileMenu.classList.add('hidden');
            mobileToggle.setAttribute('aria-label', 'Åpne meny');
            if (iconOpen && iconClose) {
                iconOpen.classList.remove('hidden');
                iconClose.classList.add('hidden');
            }
        });

        // Close on Escape
        document.addEventListener('keydown', (e) => {
            if (menuOpen && e.key === 'Escape') {
                menuOpen = false;
                mobileToggle.setAttribute('aria-expanded', 'false');
                mobileMenu.classList.add('hidden');
                mobileToggle.setAttribute('aria-label', 'Åpne meny');
                if (iconOpen && iconClose) {
                    iconOpen.classList.remove('hidden');
                    iconClose.classList.add('hidden');
                }
                mobileToggle.focus();
            }
        });
    }

    // Dark mode toggle
    const themeToggle = document.getElementById('theme-toggle');
    const iconSun = document.getElementById('theme-icon-sun');
    const iconMoon = document.getElementById('theme-icon-moon');

    function applyTheme(mode: 'dark' | 'light') {
        if (mode === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
            iconSun?.classList.remove('hidden');
            iconMoon?.classList.add('hidden');
        } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
            iconSun?.classList.add('hidden');
            iconMoon?.classList.remove('hidden');
        }
        // Persist preference
        try { localStorage.setItem('theme', mode); } catch { /* noop */ }
    }

    // Restore saved preference or respect system
    var saved = null;
    try { saved = localStorage.getItem('theme'); } catch { /* noop */ }
    if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        applyTheme('dark');
    }

    themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        applyTheme(isDark ? 'light' : 'dark');
    });
</script>

---
/**
 * Clickable player card — used in roster lists.
 * Links to the player's profile page at `/p/[slug]`.
 */
import type { Player } from '../types/strapi';
import { mediaUrl, mediaAlt } from '../lib/strapi';

interface Props {
	player: Player;
	class?: string;
}

const { player, class: className = '' } = Astro.props;
const href = `/p/${player.slug}`;
---

<a
	href={href}
	class={`flex cursor-default items-center gap-3 rounded-card border border-line bg-surface-raised p-3 transition-colors hover:bg-brand-50 dark:hover:bg-brand-900 ${className}`}
>
	{player.photo && (
		<img
			src={mediaUrl(player.photo, 'small') ?? ''}
			alt={mediaAlt(player.photo)}
			class="size-12 shrink-0 rounded-full object-cover"
		/>
	)}
	<div>
		<p class="font-semibold">
			{player.number && (
				<span class="text-brand-500">#{player.number}</span>
			)}
			<span class="ml-1">{player.name}</span>
		</p>
		{player.position && (
			<p class="text-xs text-ink-muted">{player.position}</p>
		)}
	</div>
</a>

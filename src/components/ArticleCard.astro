---
import type { Article } from '../types/strapi';
import { mediaUrl, mediaAlt, formatDate } from '../lib/strapi';

interface Props {
  article: Article;
  /** The lead story on the front page gets a wider treatment. */
  featured?: boolean;
}

const { article, featured = false } = Astro.props;

const cover = mediaUrl(article.cover, featured ? 'large' : 'medium');
const href = `/nyheter/${article.slug}`;

const SECTION_LABEL: Record<string, string> = {
  klubb: 'Klubb',
  elite: 'Elite',
  bredde: 'Bredde',
};
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-card border border-line bg-surface-raised shadow-card transition-shadow hover:shadow-lift',
    featured && 'sm:col-span-2 sm:flex-row',
  ]}
>
  {
    cover && (
      <div class:list={['overflow-hidden bg-surface-sunken', featured ? 'sm:w-1/2' : '']}>
        <img
          src={cover}
          alt={mediaAlt(article.cover)}
          width={article.cover?.width ?? undefined}
          height={article.cover?.height ?? undefined}
          loading={featured ? 'eager' : 'lazy'}
          decoding="async"
          class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] sm:h-full"
        />
      </div>
    )
  }

  <div class:list={['flex flex-1 flex-col p-5', featured && 'sm:justify-center sm:p-8']}>
    <div class="flex items-center gap-2 text-xs uppercase tracking-wide text-ink-muted">
      <span class="rounded-pill bg-surface-sunken px-2 py-0.5 font-semibold text-ink">
        {SECTION_LABEL[article.section] ?? article.section}
      </span>
      {article.category === 'kampreferat' && <span>Kampreferat</span>}
      <time datetime={article.publishDate}>{formatDate(article.publishDate)}</time>
    </div>

    <h3 class:list={['mt-3 leading-tight', featured ? 'text-display' : 'text-xl']}>
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">
        {article.title}
      </a>
    </h3>

    <p class="mt-2 line-clamp-3 text-sm text-ink-muted">{article.excerpt}</p>

    {
      article.team && (
        <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-brand-500">
          {article.team.name}
        </p>
      )
    }
  </div>
</article>

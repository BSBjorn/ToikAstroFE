# --- Strapi ------------------------------------------------------------
# Reachable from the browser. Used for media URLs and the live match island.
# PUBLIC_ prefix exposes it to client code — that is intended here.
PUBLIC_STRAPI_URL=http://localhost:1337

# Server-side only. In Coolify, the internal service hostname, so rendering
# never leaves the host. Leave blank locally to fall back to the public URL.
STRAPI_INTERNAL_URL=

# This site's own public URL — canonical links, sitemap, Open Graph.
PUBLIC_SITE_URL=http://localhost:4321

# --- Cache invalidation -------------------------------------------------
# Shared with the Strapi webhook header x-revalidate-secret.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
